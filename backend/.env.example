# APICostGuard Backend - Environment Variables

# Server
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
APP_ENV=development

# Database
DATABASE_URL=sqlite:apicostguard.db

# Gateway auth (optional, REQUIRED in production). When set, /v1/* gateway
# routes require "Authorization: Bearer <token>". In production the backend
# logs a warning at startup if this is left unset.
APICOSTGUARD_GATEWAY_TOKEN=

# CORS (optional). Comma-separated list of allowed browser origins, e.g.
# "https://apicostguard.vercel.app". Empty = allow any origin. In production
# the backend logs a warning at startup if this is left empty.
# ALLOWED_ORIGINS=https://apicostguard.vercel.app

# Budget defaults (editable from the app UI, stored in the database)
MONTHLY_LIMIT_USD=100.0
DAILY_LIMIT_USD=10.0
ALERT_THRESHOLD_PERCENT=80
