# APICostGuard Backend - Environment Variables

# Server
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
APP_ENV=development

# Database
DATABASE_URL=sqlite:apicostguard.db

# Gateway auth (optional). When set, /v1/* gateway routes require
# "Authorization: Bearer <token>". Leave unset to keep the gateway open.
APICOSTGUARD_GATEWAY_TOKEN=

# Budget defaults (editable from the app UI, stored in the database)
MONTHLY_LIMIT_USD=100.0
DAILY_LIMIT_USD=10.0
ALERT_THRESHOLD_PERCENT=80
