HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
APP_ENV=development

DATABASE_URL=sqlite:apicostguard.db

# Required for company / LAN use. Single-user desktop can leave empty.
# Must match frontend VITE_API_TOKEN.
APICOSTGUARD_GATEWAY_TOKEN=

# Comma-separated allowed origins. Empty = local-only development.
# Production example: ALLOWED_ORIGINS=https://app.example.com
ALLOWED_ORIGINS=

MONTHLY_LIMIT_USD=100.0
DAILY_LIMIT_USD=10.0
ALERT_THRESHOLD_PERCENT=80
