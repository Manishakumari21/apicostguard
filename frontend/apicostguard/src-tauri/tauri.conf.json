{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APICostGuard",
  "version": "0.1.0",
  "identifier": "com.apicostguard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "APICostGuard",
        "width": 1280,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 750,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/apicostguard_backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzRTgwRUUzOUNBNjg5MTgKUldRWWlhYWM0dzdvTTdTNU5PdGZwRHJUVndyZXg3alozSjgrTGlCenl0THdzL1N4K3RpU0tHUXAK",
      "endpoints": [
        "https://github.com/Manishakumari21/apicostguard/releases/latest/download/latest.json"
      ]
    }
  }
}
