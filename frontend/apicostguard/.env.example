# Base URL of the APICostGuard backend.
#
# Leave unset (or empty) for local dev to use the default, or point it at the
# local backend, e.g. http://localhost:8080
#
# The web build (npm run build, used by Vercel) ignores this and always uses
# .env.web, which sets it to empty so the browser calls the same-origin
# serverless proxy at /api/*.
VITE_API_BASE_URL=http://localhost:8080

# There is no VITE_API_TOKEN and there must not be one.
#
# The gateway token (APICOSTGUARD_GATEWAY_TOKEN) is a server-side secret. On
# the web deployment it is set in Vercel and Render only, and injected into the
# outbound request by api/index.ts. Anything prefixed VITE_ is compiled into
# the public bundle, so the build fails if this variable is ever defined.
