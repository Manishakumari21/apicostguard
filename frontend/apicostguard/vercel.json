{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api?path=health"
    },
    {
      "source": "/version",
      "destination": "/api?path=version"
    }
  ]
}
